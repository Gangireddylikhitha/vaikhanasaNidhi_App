# Local dev — use Vite proxy (vite.config.js forwards /api → localhost:5000)
# VITE_API_BASE_URL=/api

# Or call backend directly (requires CORS / matching CLIENT_ORIGIN):
VITE_API_BASE_URL=http://localhost:5000/api

# Production (Vercel + mobile APK builds use .env.production automatically)
# VITE_API_BASE_URL=https://vaikhanasa-nidhi-api.onrender.com/api

# Mobile APK build (Capacitor): run `npm run cap:sync` — uses .env.production
# Emulator + local backend only: use http://10.0.2.2:5000/api (not localhost)
