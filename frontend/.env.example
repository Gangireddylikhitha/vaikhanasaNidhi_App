# Frontend env files (Vite):
#   .env.development  → npm run dev
#   .env.production   → npm run build, Capacitor APK, Vercel builds
#
# If VITE_API_BASE_URL is unset, local dev defaults to http://127.0.0.1:5000/api

# Local backend (uncomment for local-only dev):
# VITE_API_BASE_URL=http://127.0.0.1:5000/api

# Deployed API (Elastic Beanstalk / Render / custom domain):
VITE_API_BASE_URL=http://vaikhanasa-api.ap-south-1.elasticbeanstalk.com/api

# Android emulator + local backend only:
# VITE_API_BASE_URL=http://10.0.2.2:5000/api
